{
  "name": "ai-jira-project-management-monitoring-system",
  "version": "1.0.0",
  "description": "AI-Powered Jira Project Management Monitoring System",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm --prefix backend run start",
    "start:frontend": "npm --prefix frontend run start",
    "build": "cd backend && npm install && npx prisma generate && cd ../frontend && npm install && npm run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "seed": "npm --prefix backend run seed"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@prisma/client": "^7.10.0",
    "cross-env": "^7.0.3",
    "express": "^5.2.1",
    "next": "14.2.3",
    "prisma": "^8.0.0-rc.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
